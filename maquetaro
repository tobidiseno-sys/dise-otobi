<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rocío Damn — Repartiendo arte</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Yellowtail&family=Work+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --rose:         #E7AEB8;
    --rose-dark:    #D18F9C;
    --rose-deep:    #BE7986;
    --rose-strip:   #DDB5BC;
    --rose-pale:    #F9E6E7;
    --blush:        #FBEDEA;
    --blush-soft:   #FCF2F0;
    --cream:        #FFFCFA;
    --ink:          #221A19;
    --ink-soft:     #6E5C59;
    --ink-faint:    #9C8B88;
    --line:         rgba(34,26,25,0.12);
    --shadow:       0 18px 40px -22px rgba(34,26,25,0.35);
    --shadow-sm:    0 8px 20px -12px rgba(34,26,25,0.28);
    --radius:       12px;
    --radius-sm:    8px;
    --disp:         "Fraunces", serif;
    --script:       "Yellowtail", cursive;
    --body:         "Work Sans", sans-serif;
  }

  *{ margin:0; padding:0; box-sizing:border-box; }
  html{ scroll-behavior:smooth; }
  body{
    background:var(--blush);
    color:var(--ink);
    font-family:var(--body);
    font-size:16px;
    line-height:1.6;
    -webkit-font-smoothing:antialiased;
  }
  img,svg{ display:block; max-width:100%; }
  a{ color:inherit; text-decoration:none; }
  ul{ list-style:none; }
  button{ font-family:inherit; }
  section{ position:relative; }
  .wrap{ max-width:1280px; margin:0 auto; padding:0 40px; }
  @media(max-width:640px){ .wrap{ padding:0 20px; } }

  h1,h2,h3,h4{ font-family:var(--disp); font-weight:600; color:var(--ink); letter-spacing:-0.01em; }
  em.script{ font-family:var(--script); font-style:normal; color:var(--rose-dark); font-weight:400; }

  .btn{
    display:inline-flex; align-items:center; justify-content:center; gap:10px; padding:15px 28px;
    background:var(--rose); color:#fff; font-family:var(--body); font-weight:600;
    font-size:13.5px; letter-spacing:0.04em; text-transform:uppercase; border:1px solid var(--rose); cursor:pointer;
    transition:background .3s ease, transform .3s ease, border-color .3s ease; border-radius:var(--radius-sm);
  }
  .btn:hover{ background:var(--rose-deep); border-color:var(--rose-deep); transform:translateY(-2px); }
  .btn.outline{ background:transparent; color:var(--ink); border-color:var(--ink); }
  .btn.outline:hover{ background:var(--ink); color:var(--cream); }
  .btn.dark{ background:var(--ink); border-color:var(--ink); color:var(--cream); }
  .btn.dark:hover{ background:var(--rose-deep); border-color:var(--rose-deep); }

  .reveal{ opacity:0; transform:translateY(24px); transition:opacity .7s ease, transform .7s ease; }
  .reveal.in{ opacity:1; transform:translateY(0); }
  @media (prefers-reduced-motion:reduce){ .reveal{ opacity:1; transform:none; transition:none; } html{ scroll-behavior:auto; } }

  .eyebrow{
    font-family:var(--body); font-size:13px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--ink); font-weight:700;
  }

  /* ======= TOPBAR ======= */
  .topbar{
    background:var(--rose-strip); color:#fff; font-size:12.5px; letter-spacing:0.05em;
    text-align:center; padding:10px 14px; font-weight:600;
  }
  .topbar .wrap{ display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap; }
  .topbar svg{ width:14px; height:14px; stroke:#fff; }
  .topbar .dot{ opacity:.7; }
  @media(max-width:560px){ .topbar{ font-size:11px; } }

  /* ======= HEADER ======= */
  header{ background:var(--cream); border-bottom:1px solid var(--line); }
  .header-main{ display:flex; align-items:center; justify-content:space-between; gap:32px; padding:22px 0; }
  .brand-block{ flex-shrink:0; }
  .brand-block a{ display:block; }
  .brand-script{ font-family:var(--script); font-size:36px; color:var(--rose); line-height:1; }
  .brand-sub{ font-size:12px; letter-spacing:0.3em; color:var(--ink); font-weight:600; margin-top:2px; }

  .search-bar{
    flex:1; max-width:520px; position:relative; display:flex; align-items:center;
  }
  .search-bar input{
    width:100%; padding:14px 52px 14px 20px; border:1px solid var(--line); border-radius:30px;
    background:var(--blush-soft); font-family:var(--body); font-size:14px; color:var(--ink);
  }
  .search-bar input::placeholder{ color:var(--ink-faint); }
  .search-bar input:focus{ outline:2px solid var(--rose); outline-offset:1px; }
  .search-bar button{
    position:absolute; right:6px; top:6px; bottom:6px; width:38px; border:none; border-radius:50%;
    background:var(--rose); display:flex; align-items:center; justify-content:center; cursor:pointer;
  }
  .search-bar button svg{ width:16px; height:16px; stroke:#fff; }

  .header-actions{ display:flex; align-items:center; gap:28px; flex-shrink:0; }
  .head-link{ display:flex; align-items:center; gap:9px; font-size:14px; font-weight:600; }
  .head-link svg{ width:22px; height:22px; stroke:var(--ink); fill:none; stroke-width:1.6; }
  .cart-link{ position:relative; display:flex; align-items:center; gap:9px; font-size:14px; font-weight:600; }
  .cart-link svg{ width:22px; height:22px; stroke:var(--ink); fill:none; stroke-width:1.6; }
  .cart-badge{
    position:absolute; top:-8px; left:12px; background:var(--rose-deep); color:#fff; font-size:10.5px;
    font-weight:700; width:18px; height:18px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  }
  @media(max-width:860px){ .search-bar{ display:none; } .head-link span{ display:none; } }

  .burger{ display:none; background:none; border:none; cursor:pointer; }
  .burger span{ display:block; width:24px; height:1.6px; background:var(--ink); margin:5px 0; }

  nav.mainnav{ background:var(--cream); border-bottom:1px solid var(--line); }
  .nav-links{ display:flex; align-items:center; justify-content:center; gap:44px; padding:16px 0; font-size:13.5px; font-weight:600; letter-spacing:0.03em; text-transform:uppercase; }
  .nav-links a{ position:relative; padding-bottom:6px; color:var(--ink-soft); transition:color .25s ease; }
  .nav-links a:hover{ color:var(--ink); }
  .nav-links a.active{ color:var(--ink); }
  .nav-links a.active::after{ content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:var(--rose); }

  @media(max-width:860px){
    .nav-links{
      position:fixed; inset:0 0 0 auto; top:0; height:100vh; width:80%; max-width:320px;
      background:var(--cream); flex-direction:column; align-items:flex-start; padding:110px 34px; gap:26px;
      transform:translateX(100%); transition:transform .4s ease; box-shadow:var(--shadow); font-size:16px;
    }
    .nav-links.open{ transform:translateX(0); }
    .burger{ display:block; }
  }

  /* ======= HERO ======= */
  .hero{ background:var(--blush); padding:64px 0 0; overflow:hidden; }
  .hero-grid{ display:grid; grid-template-columns:1fr 1fr; gap:56px; align-items:center; padding-bottom:56px; }
  .hero-copy .eyebrow{ color:var(--rose-dark); display:block; margin-bottom:18px; }
  .hero h1{ font-size:clamp(38px,4.4vw,58px); line-height:1.08; margin-bottom:24px; font-weight:600; }
  .hero-divider{ display:flex; align-items:center; gap:14px; width:220px; margin-bottom:24px; }
  .hero-divider span{ flex:1; height:1px; background:var(--rose); opacity:.5; }
  .hero-divider svg{ width:16px; height:16px; fill:var(--rose); flex-shrink:0; }
  .hero p.lede{ font-size:16.5px; color:var(--ink-soft); max-width:440px; margin-bottom:34px; }
  .hero-actions{ display:flex; gap:16px; flex-wrap:wrap; margin-bottom:52px; }
  .hero-stats{ display:flex; gap:52px; flex-wrap:wrap; }
  .hero-stat{ display:flex; align-items:center; gap:12px; }
  .hero-stat .ic{ width:26px; height:26px; stroke:var(--rose); fill:none; stroke-width:1.5; flex-shrink:0; }
  .hero-stat strong{ display:block; font-family:var(--disp); font-size:26px; line-height:1; color:var(--ink); }
  .hero-stat span{ font-size:11.5px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-soft); font-weight:600; }

  .hero-art{
    position:relative; border-radius:var(--radius); overflow:hidden; aspect-ratio:4/3.15;
    background:
      radial-gradient(circle at 82% 20%, rgba(255,255,255,0.55), transparent 45%),
      linear-gradient(155deg,#EFDDCF 0%, #E7CEBA 45%, #DCB79B 100%);
  }
  .hero-art::before{
    content:""; position:absolute; left:6%; bottom:0; width:34%; height:78%;
    background:linear-gradient(180deg, rgba(255,255,255,0.35), transparent 60%);
    opacity:.5;
  }
  .frame{
    position:absolute; top:9%; left:23%; width:40%; height:82%;
    background:linear-gradient(160deg,#9A6A3E,#6E4726);
    border-radius:3px; box-shadow:var(--shadow); padding:14px;
  }
  .canvas{
    width:100%; height:100%; border-radius:1px; position:relative; overflow:hidden;
    background:
      radial-gradient(circle at 50% 32%, rgba(255,180,90,0.9), transparent 55%),
      radial-gradient(circle at 40% 60%, rgba(180,70,50,0.85), transparent 60%),
      linear-gradient(200deg,#3B1F1A 0%, #732F27 45%, #C1602F 75%, #E8934A 100%);
  }
  .canvas::after{
    content:""; position:absolute; inset:0;
    background:radial-gradient(circle at 46% 78%, rgba(255,214,120,0.9), transparent 30%);
  }
  .canvas .sig{ position:absolute; right:8px; bottom:6px; font-family:var(--body); font-size:9px; letter-spacing:0.1em; color:rgba(255,255,255,0.7); }
  .vase{ position:absolute; right:9%; bottom:6%; width:16%; }
  .vase svg{ width:100%; height:auto; }
  .bowl{ position:absolute; right:6%; bottom:2%; width:10%; opacity:.85; }
  .bowl svg{ width:100%; height:auto; }

  @media(max-width:900px){
    .hero-grid{ grid-template-columns:1fr; gap:40px; padding-bottom:40px; }
    .hero{ padding-top:44px; }
    .hero-art{ order:-1; aspect-ratio:16/11; }
  }
  @media(max-width:480px){ .hero-stats{ gap:28px; } }

  /* ======= FEATURE STRIP ======= */
  .strip{ background:var(--rose-pale); padding:26px 0; }
  .strip .wrap{ display:flex; justify-content:space-between; gap:24px; flex-wrap:wrap; }
  .strip-item{ display:flex; align-items:center; gap:14px; flex:1; min-width:220px; }
  .strip-item .ic{ width:34px; height:34px; stroke:var(--ink); fill:none; stroke-width:1.5; flex-shrink:0; }
  .strip-item h4{ font-size:13.5px; letter-spacing:0.03em; text-transform:uppercase; margin-bottom:3px; font-family:var(--body); font-weight:700; }
  .strip-item p{ font-size:13px; color:var(--ink-soft); }

  /* ======= OBRAS DISPONIBLES ======= */
  .obras{ background:var(--blush-soft); padding:80px 0; }
  .obras-head{ display:flex; align-items:baseline; justify-content:space-between; margin-bottom:36px; flex-wrap:wrap; gap:14px; }
  .obras-head h2{ font-size:22px; letter-spacing:0.06em; text-transform:uppercase; font-family:var(--body); font-weight:700; }
  .obras-head .ver-todas{ font-size:13px; font-weight:700; letter-spacing:0.05em; text-transform:uppercase; color:var(--rose-deep); display:inline-flex; align-items:center; gap:6px; }
  .obras-head .ver-todas svg{ width:14px; height:14px; stroke:var(--rose-deep); }

  .obras-grid{ display:grid; grid-template-columns:repeat(4,1fr); gap:24px; }
  .product{ background:var(--cream); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow-sm); transition:transform .3s ease, box-shadow .3s ease; }
  .product:hover{ transform:translateY(-5px); box-shadow:var(--shadow); }
  .product-art{ aspect-ratio:1/1; position:relative; overflow:hidden; }
  .fav{
    position:absolute; top:12px; right:12px; width:34px; height:34px; border-radius:50%; background:rgba(255,255,255,0.92);
    display:flex; align-items:center; justify-content:center; box-shadow:0 4px 10px rgba(0,0,0,0.12); cursor:pointer; border:none;
  }
  .fav svg{ width:16px; height:16px; stroke:var(--ink); fill:none; stroke-width:1.6; }
  .product-info{ padding:16px 18px 20px; }
  .product-info h4{ font-family:var(--body); font-weight:600; font-size:14.5px; margin-bottom:4px; }
  .product-size{ font-size:13px; color:var(--ink-soft); margin-bottom:8px; }
  .product-price{ font-family:var(--body); font-weight:700; font-size:15.5px; color:var(--ink); }

  .p1 .product-art{ background:linear-gradient(160deg,#C99368,#7B4A2E 60%,#4A2A1B); }
  .p2 .product-art{ background:linear-gradient(160deg,#D9B978,#A87A3B 60%,#5E401E); }
  .p3 .product-art{ background:linear-gradient(160deg,#E3B77E,#B9793B 55%,#7A4A20); }
  .p4 .product-art{ background:linear-gradient(160deg,#4A4340,#211D1B 60%,#0E0C0B); }
  .product-art .critter{ position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
  .product-art .critter svg{ width:58%; height:58%; opacity:.92; }

  @media(max-width:980px){ .obras-grid{ grid-template-columns:repeat(2,1fr); } }
  @media(max-width:560px){ .obras-grid{ grid-template-columns:1fr; } .obras{ padding:56px 0; } }

  /* ======= SOBRE RO (separada, debajo del carrusel) ======= */
  .about{ background:var(--cream); padding:88px 0; border-top:1px solid var(--line); }
  .about-grid{ display:grid; grid-template-columns:1.15fr 0.85fr; gap:64px; align-items:center; }
  .about-heart{ width:20px; height:20px; fill:var(--rose); display:inline-block; vertical-align:-3px; margin-left:8px; }
  .about h2{ font-size:15px; letter-spacing:0.1em; text-transform:uppercase; font-family:var(--body); font-weight:700; margin-bottom:22px; }
  .about p{ color:var(--ink-soft); margin-bottom:16px; font-size:15.5px; max-width:540px; }
  .about-tags{ display:flex; gap:12px; margin:26px 0 30px; flex-wrap:wrap; }
  .about-tags span{
    font-size:12px; letter-spacing:0.04em; text-transform:uppercase; padding:8px 14px; font-weight:600;
    border:1px solid var(--line); color:var(--ink-soft); border-radius:20px;
  }
  .portrait{
    aspect-ratio:1/1; border-radius:50%; position:relative; overflow:hidden; max-width:360px; margin:0 auto;
    background:
      radial-gradient(circle at 32% 26%, rgba(255,255,255,0.5), transparent 45%),
      linear-gradient(155deg,var(--rose-pale) 0%, var(--blush) 45%, var(--rose) 100%);
    box-shadow:var(--shadow);
  }
  .portrait::before{
    content:""; position:absolute; left:50%; bottom:-8%; width:62%; height:70%; transform:translateX(-50%);
    background:linear-gradient(180deg,#3a3230,#100d0c); border-radius:50% 50% 0 0/40% 40% 0 0;
    opacity:.92;
  }
  .portrait::after{
    content:""; position:absolute; left:50%; top:14%; width:34%; height:34%; transform:translateX(-50%);
    background:radial-gradient(circle,#caa07d,#8a6042); border-radius:50%;
  }
  @media(max-width:900px){ .about-grid{ grid-template-columns:1fr; gap:40px; text-align:center; } .about p{ margin-left:auto; margin-right:auto; } .about-tags{ justify-content:center; } .about{ padding:64px 0; } }

  /* ======= A PEDIDO ======= */
  .pedido{ padding:96px 0; background:var(--rose-pale); }
  .pedido-top{ max-width:640px; margin-bottom:60px; }
  .pedido-top .eyebrow{ color:var(--rose-deep); }
  .pedido-top h2{ font-size:clamp(28px,3.6vw,40px); margin:16px 0 18px; }
  .pedido-top p{ color:var(--ink-soft); font-size:15.5px; }

  .steps{ display:grid; grid-template-columns:repeat(5,1fr); gap:20px; margin-bottom:76px; }
  .step{ background:var(--cream); border-radius:var(--radius); padding:26px 20px; }
  .step-num{
    width:40px; height:40px; border-radius:50%; background:var(--rose); color:#fff;
    display:flex; align-items:center; justify-content:center; font-family:var(--disp); font-size:16px;
    margin-bottom:16px;
  }
  .step p{ font-size:13.5px; color:var(--ink-soft); }
  @media(max-width:920px){ .steps{ grid-template-columns:repeat(2,1fr); } }
  @media(max-width:560px){ .steps{ grid-template-columns:1fr; } .pedido{ padding:60px 0; } }

  .pricing{ display:grid; grid-template-columns:1.1fr 1fr; gap:36px; align-items:start; }
  .launch{ background:var(--ink); color:var(--cream); padding:42px; border-radius:var(--radius); position:relative; overflow:hidden; }
  .launch .eyebrow{ color:var(--rose-pale); }
  .launch h3{ color:var(--cream); font-size:26px; margin:14px 0 10px; }
  .launch p{ color:rgba(255,252,250,0.75); margin-bottom:20px; font-size:14.5px; }
  .launch-price{ display:flex; align-items:baseline; gap:12px; margin-bottom:22px; }
  .launch-price strong{ font-family:var(--disp); font-size:36px; color:var(--rose-pale); }

  .price-card{ background:var(--cream); border-radius:var(--radius); padding:32px; }
  .price-row{ display:flex; justify-content:space-between; align-items:center; padding:16px 2px; border-bottom:1px solid var(--line); font-size:15px; }
  .price-row:last-child{ border-bottom:none; }
  .price-row span:first-child{ color:var(--ink); font-weight:500; }
  .price-row span:last-child{ font-family:var(--disp); font-size:17px; color:var(--rose-deep); }
  @media(max-width:860px){ .pricing{ grid-template-columns:1fr; } }

  /* ======= CURSOS ======= */
  .cursos{ padding:96px 0; background:var(--cream); }
  .cursos-grid{ display:grid; grid-template-columns:1fr 0.9fr; gap:60px; align-items:center; }
  .cursos .eyebrow{ color:var(--rose-deep); }
  .cursos h2{ font-size:clamp(28px,3.6vw,40px); margin:16px 0 18px; }
  .cursos p{ color:var(--ink-soft); margin-bottom:16px; font-size:15.5px; }
  .cursos-list{ margin:22px 0 30px; display:flex; flex-direction:column; gap:14px; }
  .cursos-list li{ display:flex; gap:12px; align-items:flex-start; font-size:14.5px; color:var(--ink); }
  .cursos-list svg{ flex-shrink:0; margin-top:3px; stroke:var(--rose-deep); }
  .course-card{ background:var(--rose-pale); padding:44px 36px; border-radius:var(--radius); }
  .course-card .eyebrow{ margin-bottom:14px; color:var(--rose-deep); }
  .course-card h3{ font-size:24px; margin-bottom:12px; }
  .course-card p{ font-size:14.5px; color:var(--ink-soft); }
  @media(max-width:860px){ .cursos{ padding:60px 0; } .cursos-grid{ grid-template-columns:1fr; gap:36px; } }

  /* ======= NEWSLETTER ======= */
  .newsletter{ padding:80px 0; text-align:center; background:var(--rose); color:#fff; }
  .newsletter h2{ color:#fff; font-size:clamp(26px,3.6vw,36px); margin-bottom:10px; }
  .newsletter p{ color:rgba(255,255,255,0.88); margin-bottom:28px; }
  .n-form{ display:flex; justify-content:center; gap:10px; max-width:420px; margin:0 auto; flex-wrap:wrap; }
  .n-form input{ flex:1; min-width:200px; padding:14px 18px; border:none; border-radius:30px; font-family:var(--body); font-size:14.5px; }
  .n-form button{ padding:14px 26px; background:var(--ink); color:#fff; border:none; border-radius:30px; font-weight:600; font-size:14px; cursor:pointer; }

  /* ======= FOOTER ======= */
  footer{ background:var(--ink); color:rgba(255,252,250,0.75); padding:70px 0 30px; }
  .foot-grid{ display:grid; grid-template-columns:1.4fr repeat(3,1fr); gap:40px; margin-bottom:56px; }
  .foot-brand{ font-family:var(--script); font-size:30px; color:var(--rose-pale); margin-bottom:14px; }
  .foot-grid h5{ color:#fff; font-size:12px; letter-spacing:0.1em; text-transform:uppercase; margin-bottom:16px; font-weight:700; }
  .foot-grid ul{ display:flex; flex-direction:column; gap:10px; font-size:14px; }
  .foot-grid ul a:hover{ color:#fff; }
  .foot-bottom{ border-top:1px solid rgba(255,255,255,0.14); padding-top:24px; display:flex; justify-content:space-between; font-size:12.5px; flex-wrap:wrap; gap:10px; color:rgba(255,255,255,0.5); }
  @media(max-width:760px){ .foot-grid{ grid-template-columns:1fr 1fr; } }
</style>
</head>
<body>

<div class="topbar">
  <div class="wrap">
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M6 4v16M18 4v16M3 8h6M15 8h6M3 16h6M15 16h6"/></svg>
    <span>PINTURAS ORIGINALES · OBRAS ÚNICAS</span>
    <span class="dot">•</span>
    <svg viewBox="0 0 24 24" fill="none" stroke-width="1.6"><path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.6"/><circle cx="17.5" cy="18" r="1.6"/></svg>
    <span>ENVÍOS A TODO EL PAÍS</span>
  </div>
</div>

<header>
  <div class="wrap header-main">
    <div class="brand-block">
      <a href="#inicio">
        <div class="brand-script">Rocío Damn</div>
        <div class="brand-sub">REPARTIENDO ARTE</div>
      </a>
    </div>

    <form class="search-bar" onsubmit="event.preventDefault()">
